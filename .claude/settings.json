{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/pre-pr-sonar-gate.sh",
            "timeout": 30,
            "statusMessage": "Checking SonarCloud open issues before PR..."
          }
        ]
      }
    ]
  }
}
