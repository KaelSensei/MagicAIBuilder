FROM node:22-alpine
WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Install curl for health checks
RUN apk add --no-cache curl

# Install dependencies first (layer cache)
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Copy source
COPY . .

# Build Next.js app
RUN pnpm build

# Expose port
EXPOSE 3000

CMD ["pnpm", "start"]
