# ---------------------------------------------------------------
# LOCAL DEVELOPMENT (Docker)
# ---------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# .env.local is never committed (see .gitignore).
DATABASE_URL="postgresql://magic:magic@localhost:5432/magicaibuilder"

# ---------------------------------------------------------------
# PRODUCTION (Supabase + Vercel)
# ---------------------------------------------------------------
# Set these in Vercel > Project > Settings > Environment Variables.
# Never put real credentials in this file.
#
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
#
# To get your DATABASE_URL:
#   Supabase → your project → Project Settings → Database → Connection string → URI
#
# After changing the DATABASE_URL, run migrations on Supabase:
#   DATABASE_URL="postgresql://..." npx prisma migrate deploy

# ---------------------------------------------------------------
# Authentication (NextAuth.js v5)
# ---------------------------------------------------------------
# Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public app URL for callbacks (e.g., http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------
# AI (optional)
# ---------------------------------------------------------------
# Set one of these server-side only (never expose to the browser).
# Without either key the AI Deck Builder falls back to a placeholder decklist —
# colour-correct, but the same staples every time. The wizard says so on screen.
# ANTHROPIC_API_KEY wins when both are set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Monthly AI limits (optional; src/lib/ai/usage/policy.ts holds the defaults).
# Calls per user per UTC month on each route, and the spend across all users
# per UTC month in USD. A ceiling of 0 switches every AI call off.
# AI_MONTHLY_BUILD_ALLOWANCE=10
# AI_MONTHLY_SUGGEST_ALLOWANCE=30
# AI_MONTHLY_SPEND_CEILING_USD=20
