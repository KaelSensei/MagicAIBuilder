# The image tag MUST track @playwright/test in package.json: the browser
# binaries it ships live at a version-stamped path, so any drift makes every
# browser test fail to launch. Guarded by src/lib/toolchain.test.ts.
FROM mcr.microsoft.com/playwright:v1.62.1-jammy

WORKDIR /app

# Enable pnpm via corepack (Node is included in the Playwright image).
# The version MUST be pinned: bare `corepack enable` resolves to whatever is
# latest at build time, and pnpm 11 dropped support for the `pnpm.overrides`
# field in package.json — which fails the frozen install with
# ERR_PNPM_LOCKFILE_CONFIG_MISMATCH before a single test runs.
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate

# Install deps first for better layer caching
COPY package.json pnpm-lock.yaml ./
# Prisma schema is needed during postinstall (prisma generate)
COPY prisma ./prisma
RUN pnpm install --frozen-lockfile

# Copy the rest of the repo
COPY . .

# Prisma client (needed for Next.js server + API routes)
RUN pnpm exec prisma generate

ENV PLAYWRIGHT_TEST=1
ENV NODE_ENV=test

# Run E2E (will boot Next dev server via playwright.config.ts)
CMD ["pnpm", "exec", "playwright", "test"]

