{
  "name": "magic-ai-builder",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "dev:local": "next dev --hostname :: --port 3000",
    "build": "next build",
    "analyze": "cross-env ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint src e2e --max-warnings 0",
    "arch": "depcruise src --config .dependency-cruiser.cjs --ignore-known --cache node_modules/.cache/dependency-cruiser/full && depcruise src --config .dependency-cruiser.runtime.cjs --cache node_modules/.cache/dependency-cruiser/runtime",
    "arch:graph": "node scripts/arch-graph.mjs",
    "refactor:apply-moves": "tsx scripts/refactor/apply-moves.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "sonar": "node scripts/sonar.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "git:prune": "bash scripts/git-prune.sh",
    "db:seed": "tsx prisma/seed.ts",
    "prepare": "husky",
    "lighthouse": "lhci autorun"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/nextjs": "^10.78.0",
    "@tanstack/react-query": "^5.107.1",
    "@vercel/speed-insights": "^2.1.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.1.2",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.577.0",
    "next": "^15.5.29",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "pino": "^10.4.0",
    "react": "^19.2.8 <19.4",
    "react-dom": "^19.2.8 <19.4",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.5",
      "@babel/core": "^7.29.7",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "brace-expansion@>=4": "^5.0.9",
      "deepmerge-ts": "^8.0.2",
      "defu": "^6.1.7",
      "@sentry/bundler-plugins>glob": "^14.0.2",
      "js-yaml@4": "^4.3.1",
      "nanoid@3": "^3.3.18",
      "picomatch@4": "^4.0.5",
      "postcss": "^8.5.26",
      "sharp": "^0.35.3",
      "tmp": "^0.2.7",
      "uuid": "^11.1.1",
      "ws": "^8.21.3"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@lhci/cli": "^0.16.0",
    "@next/bundle-analyzer": "^16.4.5",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^16.4.0",
    "msw": "3.0.5",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "ts-morph": "28.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
