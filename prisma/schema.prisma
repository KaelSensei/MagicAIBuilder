generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A Commander (or Brawl) deck with its metadata
model Deck {
  id            String     @id @default(cuid())
  name          String
  format        String     @default("commander")
  targetBracket Int        @default(2)
  budget        Float?
  commanderId   String?
  partnerId     String?
  companionId   String?
  pairingType   String     @default("none")
  shareToken    String?        @unique
  shareEnabled  Boolean        @default(false)
  description   String         @default("")
  tags          String[]       @default([])
  cards         DeckCard[]
  snapshots     DeckSnapshot[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model DeckSnapshot {
  id        String   @id @default(cuid())
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  deckId    String
  name      String
  cardList  Json
  commander String?
  cardCount Int
  createdAt DateTime @default(now())

  @@index([deckId])
}

model DeckCard {
  id            String  @id @default(cuid())
  deck          Deck    @relation(fields: [deckId], references: [id], onDelete: Cascade)
  deckId        String
  scryfallId    String
  name          String
  manaCost      String  @default("")
  cmc           Float   @default(0)
  typeLine      String  @default("")
  oracleText    String  @default("")
  colorIdentity String[]
  isGameChanger Boolean @default(false)
  isBanned      Boolean @default(false)
  price         Float?
  imageUri      String  @default("")
  artCropUri    String  @default("")
  category      String  @default("other")
  quantity      Int     @default(1)
  isCommander   Boolean @default(false)
  isPartner     Boolean @default(false)
  notes         String?

  @@index([deckId])
}

model CardCache {
  scryfallId String   @id
  data       Json
  cachedAt   DateTime @default(now())

  @@index([cachedAt])
}

/// A card owned by the user in their physical collection
model CollectionCard {
  id         String    @id @default(cuid())
  scryfallId String
  name       String
  quantity   Int       @default(1)
  foil       Boolean   @default(false)
  condition  String?   // NM / LP / MP / HP / DMG
  acquiredAt DateTime?
  price      Float?
  imageUri   String    @default("")
  createdAt  DateTime  @default(now())

  @@unique([scryfallId, foil])
  @@index([scryfallId])
}
