generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth Models ────────────────────────────────────────────────

model User {
  id            String          @id @default(cuid())
  name          String?
  username      String?         @unique // public profile slug (e.g. /u/kael)
  onboardingDone Boolean       @default(false) // true after first-run wizard completed or skipped
  email         String          @unique
  emailVerified DateTime?
  image         String?
  password      String?         // hashed password for credentials provider (null for OAuth-only users)
  accounts      Account[]
  sessions      Session[]
  decks          Deck[]
  collection     CollectionCard[]
  favorites      CardFavorite[]
  favoriteLists  FavoriteList[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application Models ─────────────────────────────────────────────

/// A Commander (or Brawl) deck with its metadata
model Deck {
  id            String         @id @default(cuid())
  name          String
  description   String?        @default("")
  tags          String[]       @default([])
  format        String         @default("commander")
  targetBracket Int            @default(3)
  budget        Float?
  commanderId   String?
  partnerId     String?
  companionId   String?
  pairingType   String         @default("none")
  manualBracket Int?                // null = use calculated score, 1-4 = manual override
  shareToken    String?        @unique
  shareEnabled  Boolean        @default(false)
  isPublic      Boolean        @default(false) // visible on public profile page
  isAIGenerated Boolean        @default(false)
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards         DeckCard[]
  snapshots     DeckSnapshot[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
}

/// A named snapshot (version) of a deck at a point in time
model DeckSnapshot {
  id         String   @id @default(cuid())
  deckId     String
  deck       Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  name       String
  cardList   Json
  commander  String?
  cardCount  Int
  createdAt  DateTime @default(now())

  @@index([deckId])
}

model DeckCard {
  id            String  @id @default(cuid())
  deck          Deck    @relation(fields: [deckId], references: [id], onDelete: Cascade)
  deckId        String
  scryfallId    String
  name          String
  manaCost      String  @default("")
  cmc           Float   @default(0)
  typeLine      String  @default("")
  oracleText    String  @default("")
  power         String?
  toughness     String?
  colorIdentity String[]
  isGameChanger Boolean @default(false)
  isBanned      Boolean @default(false)
  price         Float?
  imageUri      String  @default("")
  artCropUri    String  @default("")
  category      String  @default("other")
  quantity      Int     @default(1)
  isCommander   Boolean @default(false)
  isPartner     Boolean @default(false)
  notes         String?
  zone          String  @default("main") // "main" | "sideboard" | "maybeboard"

  @@index([deckId])
}

model CardCache {
  scryfallId String   @id
  data       Json
  cachedAt   DateTime @default(now())

  @@index([cachedAt])
}

/// Cache for Scryfall search results (1h TTL)
model ScryfallSearchCache {
  cacheKey String   @id // sha256(query|page)
  data     Json     // ScryfallSearchResponse
  cachedAt DateTime @default(now())

  @@index([cachedAt])
}

/// Cache for meta analysis data (EDHRec, tournament results)
model MetaCache {
  id             String   @id @default(cuid())
  commanderSlug  String
  source         String   // "edhrec" | "tournament"
  data           Json
  cachedAt       DateTime @default(now())
  expiresAt      DateTime

  @@unique([commanderSlug, source])
  @@index([commanderSlug])
  @@index([expiresAt])
}

/// A card owned by the user in their physical collection
model CollectionCard {
  id         String    @id @default(cuid())
  scryfallId String
  name       String
  quantity   Int       @default(1)
  foil       Boolean   @default(false)
  condition  String?   // NM / LP / MP / HP / DMG
  acquiredAt DateTime?
  price      Float?
  imageUri   String    @default("")
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@unique([scryfallId, foil, userId])
  @@index([scryfallId])
  @@index([userId])
}

// Deck templates for reusable archetypes
model DeckTemplate {
  id            String    @id @default(cuid())
  name          String
  commanderName String
  archetype     String    // Combo, Control, Voltron, etc.
  deckList      Json      // Array of DeckCard objects (99 cards)
  author        String
  upvotes       Int       @default(0)
  source        String    @default("community") // "official" or "community"
  userId        String?   // Creator (if community)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([commanderName])
  @@index([upvotes])
}

// Card favorites & wishlists
model CardFavorite {
  id         String   @id @default(cuid())
  scryfallId String
  name       String
  typeLine   String
  cmc        Float    @default(0)
  price      Float?
  imageUri   String   @default("")
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())

  @@unique([scryfallId, userId])
  @@index([userId])
}

model FavoriteList {
  id        String              @id @default(cuid())
  name      String
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards     CardInFavoriteList[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([userId])
}

model CardInFavoriteList {
  id         String       @id @default(cuid())
  listId     String
  list       FavoriteList @relation(fields: [listId], references: [id], onDelete: Cascade)
  scryfallId String
  order      Int          @default(0)

  @@unique([listId, scryfallId])
}
