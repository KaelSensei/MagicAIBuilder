generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A Commander (or Brawl) deck with its metadata
model Deck {
  id            String         @id @default(cuid())
  name          String
  format        String         @default("commander")
  targetBracket Int            @default(2)
  budget        Float?
  commanderId   String?
  partnerId     String?
  companionId   String?
  pairingType   String         @default("none")
  cards         DeckCard[]
  snapshots     DeckSnapshot[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

/// A named snapshot (version) of a deck at a point in time
model DeckSnapshot {
  id         String   @id @default(cuid())
  deckId     String
  deck       Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  name       String
  cardList   Json
  commander  String?
  cardCount  Int
  createdAt  DateTime @default(now())

  @@index([deckId])
}

model DeckCard {
  id            String  @id @default(cuid())
  deck          Deck    @relation(fields: [deckId], references: [id], onDelete: Cascade)
  deckId        String
  scryfallId    String
  name          String
  manaCost      String  @default("")
  cmc           Float   @default(0)
  typeLine      String  @default("")
  oracleText    String  @default("")
  colorIdentity String[]
  isGameChanger Boolean @default(false)
  isBanned      Boolean @default(false)
  price         Float?
  imageUri      String  @default("")
  artCropUri    String  @default("")
  category      String  @default("other")
  quantity      Int     @default(1)
  isCommander   Boolean @default(false)
  isPartner     Boolean @default(false)
  isMaybeboard  Boolean @default(false)

  @@index([deckId])
}

model CardCache {
  scryfallId String   @id
  data       Json
  cachedAt   DateTime @default(now())

  @@index([cachedAt])
}
