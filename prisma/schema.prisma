generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth Models ────────────────────────────────────────────────

model User {
  id            String          @id @default(cuid())
  name          String?
  username      String?         @unique // public profile slug (e.g. /u/kael)
  onboardingDone Boolean       @default(false) // true after first-run wizard completed or skipped
  email         String          @unique
  emailVerified DateTime?
  image         String?
  password      String?         // hashed password for credentials provider (null for OAuth-only users)
  accounts      Account[]
  sessions      Session[]
  decks          Deck[]
  collection     CollectionCard[]
  favorites      CardFavorite[]
  favoriteLists  FavoriteList[]
  ratings        DeckRating[]
  votes          DeckVote[]
  playtests      PlaytestSession[]
  comments       DeckComment[]
  following      UserFollow[]    @relation("Following")
  followers      UserFollow[]    @relation("Followers")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application Models ─────────────────────────────────────────────

/// A Commander (or Brawl) deck with its metadata
model Deck {
  id            String         @id @default(cuid())
  name          String
  description   String?        @default("")
  tags          String[]       @default([])
  format        String         @default("commander")
  targetBracket Int            @default(3)
  budget        Float?
  commanderId   String?
  partnerId     String?
  companionId   String?
  pairingType   String         @default("none")
  manualBracket Int?                // null = use calculated score, 1-4 = manual override
  shareToken    String?        @unique
  shareEnabled  Boolean        @default(false)
  isPublic      Boolean        @default(false) // visible on public profile page
  isAIGenerated Boolean        @default(false)
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards         DeckCard[]
  snapshots     DeckSnapshot[]
  ratings       DeckRating[]
  votes         DeckVote[]
  playtests     PlaytestSession[]
  comments      DeckComment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
}

/// A named snapshot (version) of a deck at a point in time
model DeckSnapshot {
  id         String   @id @default(cuid())
  deckId     String
  deck       Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  name       String
  cardList   Json
  commander  String?
  cardCount  Int
  createdAt  DateTime @default(now())

  @@index([deckId])
}

model DeckCard {
  id            String  @id @default(cuid())
  deck          Deck    @relation(fields: [deckId], references: [id], onDelete: Cascade)
  deckId        String
  scryfallId    String
  name          String
  manaCost      String  @default("")
  cmc           Float   @default(0)
  typeLine      String  @default("")
  oracleText    String  @default("")
  power         String?
  toughness     String?
  colorIdentity String[]
  isGameChanger Boolean @default(false)
  isBanned      Boolean @default(false)
  price         Float?
  imageUri      String  @default("")
  artCropUri    String  @default("")
  category      String  @default("other")
  quantity      Int     @default(1)
  isCommander   Boolean @default(false)
  isPartner     Boolean @default(false)
  notes         String?
  zone          String  @default("main") // "main" | "sideboard" | "maybeboard"

  @@index([deckId])
}

model CardCache {
  scryfallId String   @id
  data       Json
  cachedAt   DateTime @default(now())

  @@index([cachedAt])
}

/// Cache for Scryfall search results (1h TTL)
model ScryfallSearchCache {
  cacheKey String   @id // sha256(query|page)
  data     Json     // ScryfallSearchResponse
  cachedAt DateTime @default(now())

  @@index([cachedAt])
}

/// Cache for meta analysis data (EDHRec, tournament results)
model MetaCache {
  id             String   @id @default(cuid())
  commanderSlug  String
  source         String   // "edhrec" | "tournament"
  data           Json
  cachedAt       DateTime @default(now())
  expiresAt      DateTime

  @@unique([commanderSlug, source])
  @@index([commanderSlug])
  @@index([expiresAt])
}

/// A card owned by the user in their physical collection
model CollectionCard {
  id         String    @id @default(cuid())
  scryfallId String
  name       String
  quantity   Int       @default(1)
  foil       Boolean   @default(false)
  condition  String?   // NM / LP / MP / HP / DMG
  acquiredAt DateTime?
  price      Float?
  imageUri   String    @default("")
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@unique([scryfallId, foil, userId])
  @@index([scryfallId])
  @@index([userId])
}

// Deck templates for reusable archetypes
model DeckTemplate {
  id            String    @id @default(cuid())
  name          String
  commanderName String
  archetype     String    // Combo, Control, Voltron, etc.
  deckList      Json      // Array of DeckCard objects (99 cards)
  author        String
  upvotes       Int       @default(0)
  source        String    @default("community") // "official" or "community"
  userId        String?   // Creator (if community)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([commanderName])
  @@index([upvotes])
}

// Card favorites & wishlists
model CardFavorite {
  id         String   @id @default(cuid())
  scryfallId String
  name       String
  typeLine   String
  cmc        Float    @default(0)
  price      Float?
  imageUri   String   @default("")
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())

  @@unique([scryfallId, userId])
  @@index([userId])
}

model FavoriteList {
  id        String              @id @default(cuid())
  name      String
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards     CardInFavoriteList[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([userId])
}

model CardInFavoriteList {
  id         String       @id @default(cuid())
  listId     String
  list       FavoriteList @relation(fields: [listId], references: [id], onDelete: Cascade)
  scryfallId String
  order      Int          @default(0)

  @@unique([listId, scryfallId])
}

// ─── Community ──────────────────────────────────────────────────────

/// A user's 1–5 star vote on a public deck. A row with a title is also a
/// written review, so a user's star and their review can never desync.
model DeckRating {
  id           String   @id @default(cuid())
  deckId       String
  deck         Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating       Int      // 1–5, validated at the route
  title        String?  // non-null => this row is a review
  body         String?
  helpfulCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, deckId]) // one vote per user per deck; POST upserts
  @@index([deckId])
}

/// A user's up/down vote on a public deck.
///
/// Deliberately separate from DeckRating: stars answer "how good is this deck",
/// a vote answers "should this deck rank near the top". Discovery ordering uses
/// the vote score; the star average stays the per-deck quality read.
model DeckVote {
  id        String   @id @default(cuid())
  deckId    String
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int // +1 or -1; clearing a vote deletes the row rather than storing 0
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, deckId]) // one vote per user per deck; POST upserts
  @@index([deckId])
}

/// One comment in a deck's threaded stream.
///
/// Deliberately separate from DeckRating.title/body, which is a single written
/// review per user per deck: comments are many per user, conversational, and
/// can reply to each other. Threading is a self-relation — deleting a comment
/// cascades to its replies, and deleting the deck removes the whole stream.
/// No @@unique: like PlaytestSession, every row stands on its own.
model DeckComment {
  id        String        @id @default(cuid())
  deckId    String
  deck      Deck          @relation(fields: [deckId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String? // null = top-level; replies point at any comment on the same deck
  parent    DeckComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   DeckComment[] @relation("CommentReplies")
  body      String // 1–2000 chars, validated at the route
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([deckId, createdAt])
  @@index([parentId])
}

/// One recorded goldfish playtest of a deck.
///
/// `turns` and `mulliganCount` are read off the playtest engine, but `result`
/// can only be declared by the player: the playtest is a solitaire goldfish
/// with no opponent, so nothing in the app can decide whether a run was a win.
/// A session is therefore only stored when the player says how it went.
model PlaytestSession {
  id            String   @id @default(cuid())
  deckId        String
  deck          Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  result        String // "win" | "loss" | "draw", validated at the route
  turns         Int
  mulliganCount Int      @default(0)
  difficulty    String? // "budget" | "mid-range" | "cedh"; absent means unspecified
  notes         String?
  createdAt     DateTime @default(now())

  // No unique constraint: every run is its own row — that is the whole point.
  @@index([deckId])
  @@index([deckId, createdAt])
}

/// A directed follow edge between two users.
model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}
